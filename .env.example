# Copy to .env for local development — never commit real secrets

# Server (Render sets PORT automatically in production)
PORT=3000
NODE_ENV=development

# PostgreSQL — Prisma + pg adapter
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://taxsmart_user:taxsmart_password@localhost:5433/taxsmart_db"

# Google Gemini — required at boot (OCR)
GEMINI_API_KEY=

# Redis — BullMQ OCR queue
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=          # required for cloud Redis (Upstash, Render Redis, etc.)
# REDIS_TLS=true           # set when provider requires TLS

# JWT access token
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# Refresh token (httpOnly cookie)
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refresh_token

# CORS — comma-separated origins (no trailing slash)
# Dev default if unset: http://localhost:3000,http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
